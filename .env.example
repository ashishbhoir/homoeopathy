# Copy this file to .env and fill in real values to show LIVE Google reviews.
# Without these, the site falls back to the sample reviews in src/data/content.js.

# Google Cloud API key with "Maps JavaScript API" + "Places API" enabled
# (restrict it to your website's domain under HTTP referrer restrictions).
VITE_GOOGLE_MAPS_API_KEY=

# The clinic's Google Place ID — find it at:
# https://developers.google.com/maps/documentation/places/web-service/place-id
VITE_GOOGLE_PLACE_ID=
